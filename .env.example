# Copy this file to .env, then fill in the values.
#   macOS / Linux:   cp .env.example .env
#   Windows:         copy .env.example .env
#
# .env is listed in .gitignore, so it is never committed.
# THIS file is committed - so it holds the names of the settings, never the secret values.

# The seeded customer account in the demo shop.
SHOP_EMAIL=customer@practice.test
SHOP_PASSWORD=

# Which shop to test. Leave it commented out and the suite starts the demo shop for you.
# BASE_URL=http://localhost:4175
